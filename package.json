{
  "name": "agent-instructions-kit",
  "version": "0.4.0",
  "description": "Keep your repo's agent instructions consistent and safe",
  "main": "dist/index.js",
  "files": [
    "dist/"
  ],
  "bin": {
    "agent-instructions-kit": "dist/cli/index.js"
  },
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt && ncc build src/cli.ts -o dist/cli --source-map && node scripts/normalize-dist.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "github-action",
    "agents",
    "claude",
    "ai",
    "instructions",
    "lint",
    "safety"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malmichaels-gif/agent-instructions-kit.git"
  },
  "author": "malmichaels-gif",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^10.0.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "undici": "^6.26.0"
  }
}
